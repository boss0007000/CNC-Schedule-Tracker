# Copy to .env for local development. Every setting is an environment variable.
ENV=dev                           # dev | prod  (prod enforces HTTPS-only cookies and refuses unsafe config)
DATABASE_URL=sqlite:///./var/dev.db   # prod: postgresql://user:pass@host/db?sslmode=require
SECRET_KEY=dev-insecure-secret-change-me   # prod: 32+ random chars  (python -c "import secrets;print(secrets.token_urlsafe(48))")
BASE_URL=http://localhost:8000    # public https URL in prod; used in emails and QR codes
TIMEZONE=America/Los_Angeles
ALLOWED_EMAIL_DOMAIN=csuchico.edu # also editable in Admin > Settings
FORCE_HTTPS=false                 # true behind a proxy that sets X-Forwarded-Proto
STORAGE_BACKEND=fs                # fs (local disk) | db (store uploads in Postgres; use on free hosts)
UPLOAD_DIR=./var/uploads
BACKUP_DIR=./var/backups
BACKUP_PUT_URL=                   # optional: HTTP PUT / WebDAV folder URL for nightly backups
BACKUP_PUT_AUTH=                  # optional: user:password for the URL above
EMAIL_PROVIDER=console            # console | brevo | resend | smtp
EMAIL_FROM=machineshop@example.edu
EMAIL_FROM_NAME=Student Machine Shop
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
STAFF_NOTIFY_EMAIL=               # comma-separated; new-submission alerts (default: admin/supervisor emails)
SCHEDULER_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=         # creates the first admin on boot if no staff exist
BOOTSTRAP_ADMIN_PASSWORD=
# CLAMD_HOST=clamav               # optional virus-scan hook (see docs)
